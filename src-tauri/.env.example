# Copy to src-tauri/.env for local testing — that file is gitignored, never commit it.
# Loaded at startup; real environment variables and the keyring override these.

# Google OAuth (Desktop-type client)
ARGUS_GOOGLE_CLIENT_ID=
ARGUS_GOOGLE_CLIENT_SECRET=

# GitHub OAuth app
ARGUS_GITHUB_CLIENT_ID=
ARGUS_GITHUB_CLIENT_SECRET=

# Outlook (Microsoft Entra app)
ARGUS_OUTLOOK_CLIENT_ID=

# Spotify app
ARGUS_SPOTIFY_CLIENT_ID=

# Trello API key (token goes in the keyring via Settings)
ARGUS_TRELLO_KEY=

# Self-hosted endpoints
ARGUS_GITLAB_URL=
ARGUS_HA_URL=
