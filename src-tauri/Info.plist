<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this, getUserMedia is refused outright on macOS. There is no
	     prompt, no error dialog and no fallback: the device simply never
	     opens. Linux has no equivalent string, and needs none. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Argus transcribes what you say so you can dictate a message. The audio stays on this Mac.</string>
</dict>
</plist>