{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argus",
  "version": "0.1.0",
  "identifier": "com.anyscapelabs.argus",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Argus",
        "width": 1720,
        "height": 1200,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Anyscape Labs PLC",
    "shortDescription": "Personal AI agent that lives on your machine.",
    "longDescription": "Argus is a personal AI agent that lives on your machine and grows with you. Chat, desktop control, skills, memory, a document library, and fourteen connected services — your data stays on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
